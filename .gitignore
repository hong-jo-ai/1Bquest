# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI
supabase/.temp/

# 잘못 생성된 시크릿 파일 (파일명에 키가 노출됨)
crisp plugin identifier*

# 개인 비즈니스 계획 문서
business-plan-*.md

# Moloco RMP 광고비 동기화 브라우저 세션 프로필
local-agent/.moloco-ads-*

# 전자세금계산서 복호화 브라우저 프로필
local-agent/.tax-profile

# ── 운영 산출물·임시파일 (2026-07-27) ───────────────────────────────
# 정산 엑셀·견적서 PDF·광고 소재 이미지 등 "일하면서 나온 결과물"은 커밋 대상이 아니다.
# 이것들이 미커밋 목록을 200개 넘게 채워서 정작 커밋해야 할 코드가 파묻혔음.
# ⚠️ 이미 추적 중인 파일(카페24 스킨 라이브 스냅샷 9개)은 gitignore 영향 없이 그대로 유지된다.
/downloads/
/scratchpad/
/outputs/

# 일회성 실험 스크립트 — ops.md 규칙: '_' 접두사 = 재사용 안 하는 일회성
/_*
local-agent/_*

# 저장된 웹페이지 덤프·개인 기획 문서 (business-plan-* 와 동류)
/pd.html
/폴바이스_자동화_강의_*.md

# 로컬 에이전트 의존성 — package.json/lock 으로 재현 가능. 2,571개가 추적돼
# ssh2 테스트 픽스처(더미 개인키)까지 올라가며 GitHub 푸시 보호에 걸렸음(2026-07-27)
local-agent/node_modules/
